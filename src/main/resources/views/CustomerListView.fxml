<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="vehicleshop.controllers.CustomerController"
      spacing="20" styleClass="content-area">
    
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Customers" styleClass="page-title"/>
            <Label text="Manage your customer database" styleClass="page-subtitle"/>
        </VBox>
        
        <Button fx:id="addCustomerBtn" text="➕ Add Customer" styleClass="btn-primary"
                onAction="#handleAddCustomer"/>
    </HBox>
    
    <!-- Search -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="🔍 Search by name, email, or ID..." 
                   styleClass="search-field" prefWidth="350"
                   onKeyReleased="#handleSearch"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Label fx:id="resultCount" text="0 customers" styleClass="label-secondary"/>
    </HBox>
    
    <!-- Customer Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="100"/>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="180"/>
                <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                <TableColumn fx:id="phoneCol" text="Phone" prefWidth="140"/>
                <TableColumn fx:id="addressCol" text="Address" prefWidth="200"/>
                <TableColumn fx:id="dobCol" text="DOB" prefWidth="100"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="120"/>
            </columns>
            
            <placeholder>
                <VBox alignment="CENTER" spacing="10">
                    <Label text="👥" style="-fx-font-size: 48px; -fx-text-fill: #6c6c7c;"/>
                    <Label text="No customers found" styleClass="empty-state-title"/>
                    <Label text="Add your first customer to get started" styleClass="empty-state-message"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>
    
</VBox>
