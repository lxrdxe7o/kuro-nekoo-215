<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="vehicleshop.controllers.DashboardController"
      spacing="25" styleClass="content-area">
    
    <!-- Header -->
    <VBox styleClass="content-header">
        <Label text="Dashboard" styleClass="page-title"/>
        <Label text="Overview of your vehicle shop" styleClass="page-subtitle"/>
    </VBox>
    
    <!-- Stats Cards -->
    <HBox spacing="20">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="totalCarsLabel" text="0" styleClass="stat-value"/>
            <Label text="Total Cars" styleClass="stat-label"/>
        </VBox>
        
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="totalMotorcyclesLabel" text="0" styleClass="stat-value"/>
            <Label text="Total Motorcycles" styleClass="stat-label"/>
        </VBox>
        
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="totalCustomersLabel" text="0" styleClass="stat-value"/>
            <Label text="Total Customers" styleClass="stat-label"/>
        </VBox>
        
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="totalValueLabel" text="0" styleClass="stat-value"/>
            <Label text="Inventory Value" styleClass="stat-label"/>
        </VBox>
    </HBox>
    
    <!-- Quick Actions -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <VBox styleClass="card-header">
            <Label text="Quick Actions" styleClass="card-title"/>
        </VBox>
        
        <HBox spacing="15">
            <Button fx:id="addCarBtn" text="➕ Add Car" styleClass="btn-primary" 
                    onAction="#handleAddCar"/>
            <Button fx:id="addMotorcycleBtn" text="➕ Add Motorcycle" styleClass="btn-primary"
                    onAction="#handleAddMotorcycle"/>
            <Button fx:id="addCustomerBtn" text="➕ Add Customer" styleClass="btn-secondary"
                    onAction="#handleAddCustomer"/>
        </HBox>
        
        <Region VBox.vgrow="ALWAYS"/>
        
        <!-- Recent Activity Placeholder -->
        <VBox alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
            <Label text="🚗" style="-fx-font-size: 48px; -fx-text-fill: #6c6c7c;"/>
            <Label text="Welcome to Vehicle Shop" styleClass="empty-state-title"/>
            <Label text="Use the navigation to manage vehicles and customers" styleClass="empty-state-message"/>
        </VBox>
    </VBox>
    
</VBox>
